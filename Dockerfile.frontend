# ==============================================================================
# QUASAR-TDS Frontend — Multi-Stage Production Build (Node + Nginx)
# Specification §16–§18
# ==============================================================================

# ── Stage 1: Build Vite React SPA ──────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install package dependencies
COPY dashboard/package*.json ./
RUN npm ci

# Copy dashboard source code
COPY dashboard/ ./

# Build-time environment variable for backend API endpoint
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=${VITE_API_URL}

# Compile production bundle
RUN npm run build

# ── Stage 2: Serve with High-Performance Nginx Alpine ─────────────────────────
FROM nginx:alpine

# Remove default nginx html
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration with SPA fallback and API proxying
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Built-in container health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:80/nginx-health || exit 1

CMD ["nginx", "-g", "daemon off;"]
